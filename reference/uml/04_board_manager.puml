[SCR_Board_Create] as Create
[SCR_Board_Dimensions] as Dim
[scr_board_setup] as PS
[SCR_Board_EnemySlots] as ES
[scr_board_setup] as AS
[scr_board_setup / scr_board_setup] as SF
[scr_board_slots] as Step
